# Copy to functions/.env (git-ignored) before deploying. These are plain settings, not secrets.
# Comma-separated, lower-case e-mails. An e-mail on neither list can never sign in to the admin portal.
ADMIN_HOD_EMAILS=hod@example.edu.gh
ADMIN_FINSEC_EMAILS=finsec@example.com

# Secrets (NOT in this file). Set once with the Firebase CLI:
#   firebase functions:secrets:set PAYSTACK_SECRET_KEY
#   firebase functions:secrets:set CLEANUP_TOKEN        # optional; leave unset to keep cleanDatabase disabled
